---
// This component creates the navigation bar at the top of each page
---

<nav>
	<a href="/">Home</a>
	<a href="/experience">Experience</a>
	<a href="/projects">Projects</a>
	<a href="/tiktok">TikTok</a>
</nav>

<style>
	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 12px 30px;
		padding: 20px 0;
	}

	/* Tighter spacing on phones so all 4 links fit on one line */
	@media (max-width: 480px) {
		nav {
			gap: 12px 20px;
		}
	}

	nav a {
		color: black;
		text-decoration: none;
		font-size: 18px;
		transition: color 0.2s;
	}

	nav a:hover {
		color: #555;
	}

	nav a:active {
		color: #333;
	}
</style>
