---
// Experience page - displays work experience with company logos
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="experience-content">
		<div class="experience-item">
			<img src="/assets/capital_one_logo.png" alt="Capital One" class="company-logo" />
			<div class="experience-details">
				<h2>Data Analyst Intern @ Capital One</h2>
				<p class="date">Jun 2025 - Aug 2025</p>
				<h3> Services Data & Excellence Team</h3>
			</div>
		</div>
		
		<div class="experience-item">
			<img src="/assets/ucla_logo.jpg" alt="UCLA" class="company-logo" />
			<div class="experience-details">
				<h2>Undergraduate Research @ UCLA Fielding School of Public Health</h2>
				<p class="date">March 2025 - Aug 2025</p>
				<p class="paper-link">Dataset creation and processing for <a href="https://www.sciencedirect.com/science/article/abs/pii/S0277953626003801?via%3Dihub">this paper</a></p>
			</div>
		</div>
		
		<div class="experience-item">
			<img src="/assets/liberty_mutual_logo.png" alt="Liberty Mutual" class="company-logo" />
			<div class="experience-details">
				<h2>Data Analyst Intern @ Liberty Mutual Insurance</h2>
				<p class="date">June 2024 - August 2024</p>
				<h3>Independent Agent Analytics</h3>
		</div>
		</div>
	</main>
</Layout>

<style>
	.experience-content {
		line-height: 1.8;
		color: black;
		font-size: 24px;
	}
	
	.experience-item {
		display: flex;
		align-items: flex-start;
		margin-bottom: 40px;
		gap: 16px;
	}
	
	.company-logo {
		height: 45px;
		width: auto;
		object-fit: contain;
		flex-shrink: 0;
		margin-top: 4px;
	}
	
	.experience-details {
		flex: 1;
	}
	
	.experience-details h2 {
		font-size: 20px;
		margin: 0 0 4px 0;
		font-weight: 700;
	}
	
	.date {
		margin: 0 0 12px 0;
		font-size: 14px;
		color: #555;
	}

	.experience-details h3 {
		font-size: 16px;
		font-weight: normal;
		margin: 0 0 12px 0;
	}

	.paper-link {
		font-size: 16px;
		margin: 0 0 12px 0;
		color: black;
	}

	.paper-link a {
		color: inherit;
		text-decoration: underline;
	}
	
	.bullet-points {
		list-style: none;
		padding-left: 0;
		margin: 0;
	}
	
	.bullet-points li {
		margin-bottom: 12px;
		padding-left: 20px;
		position: relative;
		font-size: 18px;
	}
	
	.bullet-points li::before {
		content: "•";
		position: absolute;
		left: 0;
		font-size: 18px;
	}
</style>
