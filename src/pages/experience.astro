---
// Experience page - displays work experience with company logos
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="experience-content">
		<div class="experience-item">
			<img src="/assets/capital_one_logo.png" alt="Capital One" class="company-logo" />
			<div class="experience-details">
				<h2>Data Analyst @ Capital One</h2>
				<p class="date">Aug 2026 - Present</p>
				<h3>Own the modernization and maintenance of data pipelines that serve internal offers to 70M+ CreditWise users, resulting in $200M+ in annual PV</h3>
			</div>
		</div>

		<div class="experience-item">
			<img src="/assets/capital_one_logo.png" alt="Capital One" class="company-logo" />
			<div class="experience-details">
				<h2>Data Analyst Intern @ Capital One</h2>
				<p class="date">Jun 2025 - Aug 2025</p>
				<h3>Reduced report retrieval times from 15 minutes to 30 seconds by migrating SQL scripts to a centralized platform, enabling audit teams to access records of 60K+ daily credit bureau dispute cases without manual email searches</h3>
			</div>
		</div>
		
		<div class="experience-item">
			<img src="/assets/ucla_logo.jpg" alt="UCLA" class="company-logo" />
			<div class="experience-details">
				<h2>Undergraduate Research @ UCLA Fielding School of Public Health</h2>
				<p class="date">March 2025 - Aug 2025</p>
				<p class="paper-link">Dataset creation and processing for <a href="https://www.sciencedirect.com/science/article/abs/pii/S0277953626003801?via%3Dihub">this paper</a></p>
			</div>
		</div>
		
		<div class="experience-item">
			<img src="/assets/liberty_mutual_logo.png" alt="Liberty Mutual" class="company-logo" />
			<div class="experience-details">
				<h2>Data Analyst Intern @ Liberty Mutual Insurance</h2>
				<p class="date">June 2024 - August 2024</p>
				<h3>Prevented a 133% increase in marketing spend by diagnosing an underpowered marketing A/B test</h3>
		</div>
		</div>
	</main>
</Layout>

<style>
	.experience-content {
		line-height: 1.8;
		color: black;
		font-size: 24px;
	}
	
	.experience-item {
		display: flex;
		align-items: flex-start;
		margin-bottom: 40px;
		gap: 16px;
	}
	
	.company-logo {
		height: 45px;
		width: auto;
		object-fit: contain;
		flex-shrink: 0;
		margin-top: 4px;
	}
	
	.experience-details {
		flex: 1;
		/* Avoid leaving a single word alone on the last line of a wrapped sentence */
		text-wrap: pretty;
	}
	
	.experience-details h2 {
		font-size: 20px;
		margin: 0 0 4px 0;
		font-weight: 700;
	}
	
	.date {
		margin: 0 0 12px 0;
		font-size: 14px;
		color: #555;
	}

	.experience-details h3 {
		font-size: 16px;
		font-weight: normal;
		margin: 0 0 12px 0;
	}

	.paper-link {
		font-size: 16px;
		margin: 0 0 12px 0;
		color: black;
	}

	.paper-link a {
		color: inherit;
		text-decoration: underline;
	}
</style>
